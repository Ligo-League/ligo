{
  "name": "ligo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @ligo/server dev",
    "worker": "pnpm --filter @ligo/worker start",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "typecheck": "tsc --noEmit && pnpm --recursive typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ligo/db generate",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/cli/migrate.ts",
    "seed": "node -e \"console.error('not implemented yet (phase 0, step 5)'); process.exit(1)\"",
    "discord:register": "pnpm --filter @ligo/server register"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
