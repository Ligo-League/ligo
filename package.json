{
  "name": "ligo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @ligo/server dev",
    "worker": "pnpm --filter @ligo/worker start",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ligo/db generate",
    "db:migrate": "pnpm --filter @ligo/db migrate",
    "seed": "pnpm --filter @ligo/db seed",
    "discord:register": "pnpm --filter @ligo/server register"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
