# Copy to deploy/.env on the VPS and fill in (docs/setup.md section 54). Never commit deploy/.env.

# The production Discord application, not the staging one pnpm dev uses.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The server slash commands are registered to (the staging server first).
DISCORD_GUILD_ID=
# Read by the seed only: the staff role of that server.
DISCORD_STAFF_ROLE_ID=

# openssl rand -base64 48 (not the one in your local .env).
SESSION_SECRET=

# Cloudflare R2: the bucket and a token with Object Read & Write on it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional.
# SITE_ADDRESS=ligoleague.eu
# DATA_DIR=/srv/ligo/data
# LOG_LEVEL=info
