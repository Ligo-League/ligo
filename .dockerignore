# Only what the server image needs goes to Docker: never .env, data/, node_modules or the
# mockups. Everything is excluded, then the needed files are let back in.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/*/package.json
!apps/server/src
!packages/*/package.json
!packages/*/src
!packages/db/migrations
!packages/render/fonts
!fixtures/*.csv
!parsers/build-r6.sh
!parsers/r6
# The fork's own history and its 100 MB of test replays are not needed to build it.
parsers/r6/.git
parsers/r6/dissect/test/data

# Tests and their helpers stay out, wherever they are.
**/*.test.ts
**/node_modules
