# Copy this file to .env and fill it in. Never commit .env.
# docs/setup.md explains where each Discord value comes from.

# --- Needed now (phases 0 and 1) ---

# Bot token: Developer Portal > your application > Bot > Reset Token. Secret.
DISCORD_TOKEN=
# Application ID: Developer Portal > your application > General Information.
DISCORD_CLIENT_ID=
# ID of the staging Discord server. Slash commands are registered to this server only.
DISCORD_GUILD_ID=
# ID of the role whose members are league staff in that server (right-click the role > Copy Role ID).
# `pnpm seed` links the server to LFR with it; staff commands check it.
DISCORD_STAFF_ROLE_ID=
# SQLite database file, relative to the repository root.
DATABASE_PATH=./data/ligo.db
# Prepared team logos (pnpm assets:logos), relative to the repository root.
ASSETS_DIR=./data/assets/render
# Files the server keeps, such as score screenshots (staff only, never public). Back it up.
STORAGE_DIR=./data/storage
# The R6 parser build (pnpm parsers:build), used by the server and the worker. Without it, the
# website refuses replay uploads.
PARSERS_DIR=./parsers/dist
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
# Where the website listens (phase 3). 127.0.0.1 keeps it on this computer only; 0.0.0.0 opens
# it to the home network (docs/setup.md section 14).
HOST=127.0.0.1
PORT=3000

# Website login (phase 3b). Leave both secrets empty for a site without login.
# Client secret: Developer Portal > your application > OAuth2 > Client Secret. Secret.
DISCORD_CLIENT_SECRET=
# Signs the login cookies: at least 32 random characters, e.g. `openssl rand -base64 48`. Secret;
# changing it logs everyone out.
SESSION_SECRET=
# The address people open. Discord sends them back to PUBLIC_URL/auth/callback, which must be
# listed under OAuth2 > Redirects. With login on, other addresses (127.0.0.1) redirect here.
PUBLIC_URL=http://localhost:3000
# On the VPS only, behind Caddy: true reads the visitor's scheme (https) from Caddy. Leave it
# empty when the server can be reached without the proxy, as on your computer.
TRUST_PROXY=

# --- Needed later (design doc section 13); leave commented out until then ---

# Cloudflare R2 (phase 5): all four, or none. Without them, every file stays in STORAGE_DIR and
# the server signs its own uploads (no development bucket needed).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=  (optional: another S3 address than https://<account>.r2.cloudflarestorage.com)
