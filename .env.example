# Copy this file to .env and fill it in. Never commit .env.
# docs/setup.md explains where each Discord value comes from.

# --- Needed now (phase 0) ---

# Bot token: Developer Portal > your application > Bot > Reset Token. Secret.
DISCORD_TOKEN=
# Application ID: Developer Portal > your application > General Information.
DISCORD_CLIENT_ID=
# ID of the staging Discord server. Slash commands are registered to this server only.
DISCORD_GUILD_ID=
# SQLite database file, relative to the repository root.
DATABASE_PATH=./data/ligo.db
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

# --- Needed later (design doc section 13); leave commented out until then ---

# Phase 3, website login (Discord OAuth and sessions):
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
# PUBLIC_URL=http://localhost:3000

# Phase 5, replay uploads (Cloudflare R2):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
